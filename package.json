{
  "name": "global-composer-setup",
  "version": "1.1.0",
  "description": "Manage globally installed Composer packages via composer.json with ccu.",
  "author": "Koutarou ISHIKAWA <stein2nd@gmail.com>",
  "license": "GPL-3.0-or-later",
  "bin": {
    "global-composer": "bin/global-composer"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "composer.json",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "composer",
    "global",
    "packages",
    "setup",
    "ccu",
    "composer-check-updates",
    "clui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stein2nd/global-composer-setup.git"
  },
  "homepage": "https://github.com/stein2nd/global-composer-setup#readme",
  "bugs": {
    "url": "https://github.com/stein2nd/global-composer-setup/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:docs": "s2j-docs-linter --profile base ./README.md ./CHANGELOG.md ./docs/*.md docs/**/*.md ./docsMod/*.md ./.vscode/**/*.md",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@s2j/docs-linter": "^1.0.35",
    "@types/node": "^26.6.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "@s2j/docs-linter": true,
    "esbuild": true,
    "fsevents": true
  }
}
