{
  "name": "global-composer-setup",
  "private": true,
  "version": "1.0.1",
  "description": "Manage globally installed Composer packages via composer.json with ccu.",
  "author": "Koutarou ISHIKAWA <stein2nd@gmail.com>",
  "license": "GPL-3.0-or-later",
  "bin": {
    "global-composer": "bin/global-composer"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "composer.json",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "composer",
    "global",
    "packages",
    "setup",
    "ccu",
    "composer-check-updates",
    "clui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stein2nd/global-composer-setup.git"
  },
  "homepage": "https://github.com/stein2nd/global-composer-setup#readme",
  "bugs": {
    "url": "https://github.com/stein2nd/global-composer-setup/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:docs": "s2j-docs-linter --profile base ./README.md ./CHANGELOG.md ./docs/**/*.md ./docsMod/status.md ./docsMod/modification.md ./.vscode/**/*.md ./docsMod/cli-list.md ./docsMod/cli.md ./docsMod/install.md ./docsMod/layout.md ./docsMod/legacy-scripts.md ./docsMod/license.md ./docsMod/naming.md ./docsMod/overlay-manifest.md ./docsMod/packagist-publish.md ./docsMod/specs.md ./docsMod/usage.md ./docsMod/windows.md",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@s2j/docs-linter": "^1.0.22",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@s2j/docs-linter": true,
    "esbuild": true,
    "fsevents": true
  }
}
