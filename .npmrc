# npm 12+ blocks git dependencies by default (EALLOWGIT).
# @s2j/docs-linter pulls textlint-rule-preset-wp-docs-ja from GitHub transitively.
allow-git=all

# Keep install-script allowlist here (not package.json allowScripts).
# package.json allowScripts makes npm ignore ~/.npmrc allow-scripts.
allow-scripts[]=@s2j/docs-linter
allow-scripts[]=esbuild
allow-scripts[]=fsevents
allow-scripts[]=spawn-sync
